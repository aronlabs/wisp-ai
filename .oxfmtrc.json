{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "ignorePatterns": [
    "runtime/**",
    "dist/**",
    ".eve/**",
    "**/node_modules/**",
    "config.local.json",
    "runtime-node.txt",
    "apps/desktop/src/**/*.css",
    "apps/desktop/src/**/*.html",
    "apps/desktop/src/**/*.svelte",
    "**/src-tauri/target/**",
    "**/src-tauri/resources/**",
    "**/src-tauri/gen/**",
    "**/dist/**"
  ]
}
