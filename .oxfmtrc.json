{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "ignorePatterns": [
    "runtime/**",
    "dist/**",
    ".eve/**",
    "node_modules/**",
    "config.local.json",
    "runtime-node.txt",
    "app/**/*.css",
    "app/**/*.html",
    "app/**/*.svelte",
    "src-tauri/target/**",
    "src-tauri/resources/**",
    "src-tauri/gen/**",
    "dist-ui/**"
  ]
}
