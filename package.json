{
  "name": "wisp-ai",
  "version": "0.2.2",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "agent": "eve dev",
    "start": "node src/main.ts",
    "install-addon": "node scripts/install.ts",
    "check": "oxfmt --check && stylua --check addon tests && oxlint --deny-warnings src agent scripts tests && tsc --noEmit && svelte-check --tsconfig app/tsconfig.json && prettier --plugin prettier-plugin-svelte --check \"app/**/*.{svelte,css,html}\"",
    "test": "node --test tests/*.test.ts",
    "build:desktop": "node scripts/build-desktop.ts",
    "package:windows": "npm run build:desktop",
    "format": "oxfmt --write && stylua --verify addon tests && prettier --plugin prettier-plugin-svelte --write \"app/**/*.{svelte,css,html}\"",
    "format:check": "oxfmt --check && stylua --check addon tests",
    "lint": "oxlint --deny-warnings src agent scripts tests",
    "lint:fix": "oxlint --fix src agent scripts tests",
    "typecheck": "tsc --noEmit",
    "format:js": "oxfmt --write",
    "format:lua": "stylua --verify addon tests",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:check": "svelte-check --tsconfig app/tsconfig.json",
    "desktop:dev": "tauri dev",
    "format:ui": "prettier --plugin prettier-plugin-svelte --write \"app/**/*.{svelte,css,html}\"",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.110",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.137",
    "eve": "1.0.0-rc.6",
    "jose": "^6.2.15",
    "just-bash": "^3.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@johnnymorganz/stylua-bin": "^2.6.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.0.0",
    "fengari": "^0.1.4",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
